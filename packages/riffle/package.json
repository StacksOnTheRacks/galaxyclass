{
  "name": "@galaxyclass/riffle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build:vendor && npm run build:client && npm run build:server",
    "build:vendor": "npm run build --prefix vendor/turnur-sdk",
    "build:dashboard-riffle": "node scripts/build-dashboard-riffle.mjs",
    "build:client": "node scripts/build-client.mjs",
    "build:server": "node scripts/build-server.mjs",
    "dev": "tsx watch src/server/main.ts",
    "postinstall": "npm run build:vendor",
    "start": "node dist/server/main.js",
    "test": "npm run build:client && vitest run",
    "test:watch": "npm run build:client && vitest"
  },
  "dependencies": {
    "@aws-sdk/client-apigatewaymanagementapi": "^3.787.0",
    "@aws-sdk/client-dynamodb": "^3.787.0",
    "@aws-sdk/lib-dynamodb": "^3.787.0",
    "@galaxyclass/accounts": "*",
    "@hono/node-server": "^1.14.1",
    "@turnur/sdk": "file:./vendor/turnur-sdk",
    "hono": "^4.7.7",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.1",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.25.2",
    "happy-dom": "^17.4.4",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vitest": "^5.0.2"
  }
}
