play uppercase tracking-wide transition duration-quick ease-snap disabled:cursor-wait bg-accent text-accent-ink shadow-press hover:brightness-110 active:translate-y-[var(--btn-press)] active:shadow-press-down disabled:translate-y-[var(--btn-press)] disabled:shadow-press-down min-h-12 px-7 text-body mt-auto w-full after:absolute after:inset-0 after:content-['']">Enter <span class="sr-only">Warships</span> room<span aria-hidden="true" class="font-body text-[1.1em] leading-none">→</span></a></div></article></li><li><article aria-label="Whodunit?" class="room-card h-full" style="--room: var(--c-whodunit);"><div class="p-2 pb-0 sm:p-3 sm:pb-0"><div aria-hidden="true" class="crt flex items-center justify-center bg-[radial-gradient(ellipse_at_50%_30%,rgb(var(--c-whodunit)/0.18),rgb(var(--c-whodunit-night))_72%)] aspect-[16/9]"><svg viewBox="0 0 160 90" class="h-full w-full"><rect width="160" height="74" class="fill-whodunit/10 opacity-0 motion-safe:animate-[storm-flash_7s_linear_infinite]"></rect><circle cx="10" cy="7" r="0.5" class="fill-ink/60"></circle><circle cx="30" cy="15" r="0.4" class="fill-ink/60"></circle><circle cx="46" cy="6" r="0.6" class="fill-ink/60"></circle><circle cx="60" cy="16" r="0.4" class="fill-ink/60"></circle><circle cx="100" cy="6" r="0.5" class="fill-ink/60"></circle><circle cx="114" cy="19" r="0.4" class="fill-ink/60"></circle><circle cx="124" cy="8" r="0.4" class="fill-ink/60"></circle><circle cx="150" cy="28" r="0.5" class="fill-ink/60"></circle><circle cx="154" cy="9" r="0.6" class="fill-ink/60"></circle><circle cx="136" cy="15" r="11" class="fill-whodunit-brass/10"></circle><path d="M136 8 A7 7 0 0 0 136 22 A9 9 0 0 1 136 8 Z" class="fill-whodunit-brass/90"></path><polyline points="22,1 16,13 21,12.5 14,27" class="fill-none stroke-whodunit opacity-0 motion-safe:animate-[storm-flash_7s_linear_infinite]" stroke-width="0.9" stroke-linejoin="round"></polyline><g class="fill-void stroke-whodunit-brass/45" stroke-width="0.6" stroke-linejoin="round