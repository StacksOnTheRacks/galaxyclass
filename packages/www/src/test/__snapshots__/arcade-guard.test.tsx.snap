exports[`arcade guard > renders the Arcade page DOM unchanged 1`] = `"<div class="app-backdrop relative isolate flex min-h-screen flex-col pb-[calc(theme(spacing.tabbar)+env(safe-area-inset-bottom))] font-body md:pb-0 arcade"><a href="#main" class="sr-only z-50 rounded-md bg-mark px-4 py-2 font-display text-accent-ink focus:not-sr-only focus:fixed focus:left-4 focus:top-4">Skip to content</a><header class="sticky top-0 z-40 border-b border-bezel bg-void/90 backdrop-blur-md"><div class="mx-auto w-full max-w-frame px-gutter "><nav aria-label="Main" class="flex h-14 items-center justify-between gap-4 md:h-16"><div class="flex items-center gap-8"><a href="/" class="group flex shrink-0 items-center gap-2 sm:gap-3"><span class="arcade-mark size-9 items-center justify-center rounded-md border-2 border-pink bg-void font-display text-[14px] text-pink shadow-glow-pink transition duration-quick group-hover:text-ink sm:size-10 sm:text-[15px]" aria-hidden="true">GC</span><span class="logo-text flex flex-col gap-0.5 whitespace-nowrap leading-none"><span class="wordmark font-display text-[13px] text-ink sm:text-[17px]">Galaxy Class</span><span class="logo-kicker font-hud text-[9px] uppercase tracking-[0.3em] text-ink-muted sm:text-[10px]">Gaming</span></span></a><ul class="hidden items-center gap-1 md:flex"><li><a href="/arcade" aria-current="page" class="relative inline-flex min-h-11 items-center px-3 font-display text-[14px] uppercase tracking-wider transition duration-quick hover:text-ink text-ink after:absolute after:inset-x-3 after:bottom-1 after:h-[3px] after:rounded-full after:bg-mark after:shadow-glow-mark">Arcade</a></li><li><a href="/about" class="relative inline-flex min-h-11 items-center px-3 font-display text-[14px] uppercase tracking-wider transition duration-quick hover:text-ink text-ink-muted">About</a></li></ul></div><div class="flex items-center gap-2 sm:gap-3"><a href="/sign-in" class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-button font-display uppercase tracking-wide transition duration-quick ease-snap disabled:cursor-wait text-ink underline-offset-[6px] hover:text-mark hover:underline min-h-11 px-5 text-label px-3 max-md:hidden">Sign in</a><a href="/sign-up" class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-button font-display uppercase tracking-wide transition duration-quick ease-snap disabled:cursor-wait bg-accent text-accent-ink shadow-press hover:brightness-110 active:translate-y-[var(--btn-press)] active:shadow-press-down disabled:translate-y-[var(--btn-press)] disabled:shadow-press-down min-h-11 px-5 text-label max-sm:min-h-10 max-sm:px-4">Sign up</a></div></nav></div></header><main id="main" class="flex-1"><div class="mx-auto w-full max-w-frame px-gutter flex flex-col gap-6 pt-6 md:gap-8 md:pt-10"><header class="flex flex-col gap-2"><p class="font-hud text-hud uppercase text-cyan ">Galaxy Class · The Arcade</p><h1 class="font-display text-display-l uppercase">Pick a room</h1><p class="max-w-[56ch] text-ink-muted md:text-body-l">Every room is a different game. Step inside, choose a table, and play in your browser.</p></header><section id="rooms" aria-labelledby="rooms-heading" class="flex flex-col gap-4"><h2 id="rooms-heading" class="sr-only">Rooms</h2><ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 lg:gap-6"><li><article aria-label="Riffle Poker" class="room-card h-full" style="--room: var(--c-riffle);"><div class="p-2 pb-0 sm:p-3 sm:pb-0"><div aria-hidden="true" class="crt bg-[radial-gradient(ellipse_at_50%_30%,rgb(var(--c-riffle)/0.12),transparent_70%)] p-5 aspect-[16/9]"><div class="relative h-full w-full"><div class="felt absolute inset-[8%] rounded-[999px] border-[8px] border-riffle-rail shadow-[inset_0_0_32px_rgb(0_0_0/0.6),0_0_0_2px_rgb(var(--c-riffle)/0.35)]"></div><span class="absolute flex size-7 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full font-hud text-[8px] uppercase border-2 border-riffle bg-void text-riffle shadow-glow-riffle" style="left: 50%; top: 100%;">You</span><span class="absolute flex size-7 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full font-hud text-[8px] uppercase border-2 border-dashed border-ink/40 bg-void/80 text-ink/60" style="left: 10%; top: 76%;"></span><span class="absolute flex size-7 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full font-hud text-[8px] uppercase border-2 border-dashed border-ink/40 bg-void/80 text-ink/60" style="left: 10%; top: 24%;"></span><span class="absolute flex size-7 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full font-hud text-[8px] uppercase border-2 border-dashed border-ink/40 bg-void/80 text-ink/60" style="left: 50%; top: 0%;"></span><span class="absolute flex size-7 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full font-hud text-[8px] uppercase border-2 border-dashed border-ink/40 bg-void/80 text-ink/60" style="left: 90%; top: 24%;"></span><span class="absolute flex size-7 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full font-hud text-[8px] uppercase border-2 border-dashed border-ink/40 bg-void/80 text-ink/60" style="left: 90%; top: 76%;"></span><div class="absolute inset-0 flex flex-col items-center justify-center gap-2"><div class="flex gap-1"><div class="shrink-0 bg-ink font-body font-bold shadow-[0_6px_14px_rgb(0_0_0/0.45)] h-[44px] w-[32px] rounded-[4px] pl-[4px] pt-[3px] text-[11px] leading-[12px] text-suit-black " aria-hidden="true">A<span class="block">♠</span></div><div class="shrink-0 bg-ink font-body font-bold shadow-[0_6px_14px_rgb(0_0_0/0.45)] h-[44px] w-[32px] rounded-[4px] pl-[4px] pt-[3px] text-[11px] leading-[12px] text-suit-red " aria-hidden="true">K<span class="block">♥</span></div><div class="shrink-0 bg-ink font-body font-bold shadow-[0_6px_14px_rgb(0_0_0/0.45)] h-[44px] w-[32px] rounded-[4px] pl-[4px] pt-[3px] text-[11px] leading-[12px] text-suit-black " aria-hidden="t