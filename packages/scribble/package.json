  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.14.1",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.25.2",
    "happy-dom": "^17.6.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vitest": "^5.0.2",
    "ws": "^8.22.0"
